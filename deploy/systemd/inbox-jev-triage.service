[Unit]
Description=inbox-jev triage pass
After=docker.service network-online.target
Requires=docker.service
# A failed run posts a Slack alert (scripts/alert.sh); off without ALERT_SLACK_CHANNEL.
OnFailure=inbox-jev-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/inbox-jev
ExecStart=/usr/bin/docker compose run --rm -T app run
TimeoutStartSec=15min
