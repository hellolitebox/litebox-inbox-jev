# Copy to .env and fill in. Never commit .env.

# TypeSafe (https://typesafe.ai) — API key from the dashboard
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Slack bot token (scope: chat:write) used to DM the daily digest. Optional.
SLACK_BOT_TOKEN=

# Any SQLAlchemy URL. Default is a local SQLite file.
# Turso:  sqlite+libsql://<db>.turso.io?authToken=...  (needs sqlalchemy-libsql)
# Neon:   postgresql+psycopg://user:pass@host/db       (needs psycopg)
DATABASE_URL=sqlite:///data/inbox-jev.db

# Google OAuth "Desktop app" client JSON downloaded from Google Cloud Console
GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secret.json
GOOGLE_TOKENS_DIR=secrets/tokens

ACCOUNTS_FILE=accounts.yaml
CATEGORIES_FILE=categories.yaml

# dry_run = only record in DB | label = also apply Gmail labels | act = also archive/spam/unsubscribe
MODE=dry_run

LOOKBACK=2d
# At least 1.
MAX_MESSAGES_PER_RUN=200
# At least 0 (0 never unsubscribes).
MAX_UNSUBSCRIBES_PER_RUN=20
# Characters of each email's body sent to Jev (the rest is cut). At least 1.
BODY_CHARS=3000
# DEBUG, INFO, WARNING, ERROR or CRITICAL (any case).
LOG_LEVEL=INFO

# uid/gid the container runs as; data/ and secrets/ must be owned by it. Choose ids that no
# host user has (check with `getent passwd <uid>`), or other users could read your tokens.
APP_UID=10100
APP_GID=10100

# The image docker compose runs. IMAGE defaults to the one CI pushes for this repo
# (ghcr.io/<owner>/<repo>); set it if you build or push your own. IMAGE_TAG is written by
# scripts/deploy.sh (sha-<short commit>); leave it unset to run :latest.
#IMAGE=ghcr.io/you/inbox-jev
#IMAGE_TAG=sha-0123abc

# ---------------------------------------------------------------------------------------------
# Host-side ops scripts (scripts/alert.sh, watchdog.sh, backup.sh, deploy.sh), run by the
# systemd units on the server, outside the app; the app doesn't read these. See README →
# "Alerts" and "Off-site backups". They also use SLACK_BOT_TOKEN, APP_UID and APP_GID above.

# Slack channel ID (C…) or user ID (U…, a DM from the bot) for failure, staleness and recovery
# alerts. Unset: alerts are off (each would-be alert logs a line instead).
#ALERT_SLACK_CHANNEL=U0123456789
# A unit that keeps failing is alerted about again after this many hours; the watchdog's stale
# alert also waits this long after an alert about a failed triage pass. At least 1.
#ALERT_REPEAT_HOURS=6
# App log lines (level, msg, account, run_id, error type) quoted in a failure alert.
#ALERT_LOG_LINES=20
# Alert when no triage pass succeeded for this long (checked every 30 min). At least 15.
#WATCHDOG_MAX_AGE_MINUTES=60
# rclone remote and folder for the nightly off-site DB backup. Unset: off-site backup is off.
#BACKUP_RCLONE_REMOTE=gdrive:inbox-jev-backups
# Off-site backups older than this many days are deleted. At least 1.
#BACKUP_RETENTION_DAYS=30
# scripts/deploy.sh keeps this many newest data/inbox-jev.db.bak-* (and .env.bak-*). At least 1.
#DEPLOY_BACKUPS_KEEP=10
